    <default class="stretch">
      <geom mass="0" solref="0.005 1"/>
      <general biastype="affine"/>
      <default class="wheel">
        <joint axis="0 0 -1" damping=".3"/>
        <motor ctrlrange="-1 1" gear="3" forcerange="-100 100"/>
